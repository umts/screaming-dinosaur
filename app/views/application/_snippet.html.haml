.bg-body-tertiary{ 'data-controller': 'clipboard' }
  .float-end
    = button_tag type: 'button',
                 class: 'btn btn-sm nav-link m-3',
                 'data-action': 'click->clipboard#copy mouseenter->clipboard#reset' do
      %i{ 'data-clipboard-target': 'indicator' }
      Copy
  %pre.p-3.m-0.bg-body-tertiary{ 'data-clipboard-target': 'source' }
    = String.new snippet
