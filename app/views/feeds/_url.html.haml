- information = capture do
  Use this address to subscribe to this calendar in another application (e.g. Google Calendar).
.input-group{ 'data-controller': 'clipboard' }
  = button_tag type: 'button', class: 'input-group-text', data: { controller: 'popover', 'bs-content': information } do
    %i.fa-solid.fa-circle-info
  .form-control
    .text-nowrap.overflow-hidden{ 'data-clipboard-target': 'source' }
      = feed_url(roster_id: roster.slug, token: Current.user.calendar_access_token, format: :ics)
  = button_tag type: 'button',
               class: 'btn btn-neutral',
               'data-action': 'click->clipboard#copy mouseenter->clipboard#reset' do
    %i{ 'data-clipboard-target': 'indicator' }
    Copy
