= render layout: 'layouts/roster', locals: { roster: @assignment_generator.roster, nav_item: 'assignments' } do
  .card
    .card-header
      Generate assignments
    = form_with model: @assignment_generator, url: generate_roster_assignments_path(@assignment_generator.roster) do |f|
      .card-body.border-bottom
        .row.g-3
          .col-md
            = f.label :start_date, 'Start Date', class: 'form-label'
            = f.date_field :start_date, required: true, class: 'form-control'
          .col-md
            = f.label :end_date, 'End Date', class: 'form-label'
            = f.date_field :end_date, required: true, class: 'form-control'
        - if @last_end_datetime.present?
          %small.form-text.text-muted
            The last existing assignment has an end time of #{l(@last_end_datetime)}.
      %div{ 'data-controller': 'template' }
        %template{ 'data-template-target': 'template' }
          = f.fields_for :definitions, AssignmentGeneratorDefinition.new, child_index: 'INDEX' do |g|
            = render partial: 'assignment_generator_definitions/fields', object: g, locals: { anchor: false }
        %div{ 'data-template-target': 'append' }
          = f.fields_for :definitions do |g|
            = render partial: 'assignment_generator_definitions/fields',
                     object: g,
                     locals: { anchor: g.object == f.object.definitions.first }
      .card-body.border-bottom
        .d-grid
          = f.button type: :submit, class: 'btn btn-outline-primary' do
            %i.fa-solid.fa-bolt
            Generate
