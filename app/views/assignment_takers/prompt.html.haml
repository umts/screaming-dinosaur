= render layout: 'layouts/roster', locals: { roster: @taker.assignment.roster, nav_item: 'assignments' } do
  .card
    .card-header
      .d-flex
        .flex-grow-1 Take Assignment
        - if allowed_to?(:edit?, @taker.assignment)
          = link_to edit_assignment_path(@taker.assignment), class: 'btn btn-sm btn-text' do
            %i.fa-solid.fa-edit
            Edit
    .card-body
      = form_with model: @taker, url: take_assignment_path(@taker.assignment) do |f|
        .mb-3
          .form-label Selected
          .list-group
            .list-group-item
              .row.row-cols-1.row-cols-md-3
                .col= l @taker.assignment.start_datetime
                .col= l @taker.assignment.end_datetime
                .col= @taker.assignment.user&.full_name
        - if @taker.assignment.assignment_group.present? && @taker.assignment.assignment_group.assignments.size > 1
          .mb-3
            .form-label
              Others in
              = @taker.assignment.assignment_group.name
            .list-group
              - (@taker.assignment.assignment_group.assignments - [@taker.assignment]).each do |assignment|
                .list-group-item
                  .row.row-cols-1.row-cols-md-3
                    .col= l assignment.start_datetime
                    .col= l assignment.end_datetime
                    .col= assignment.user&.full_name
              = f.label :group, class: 'list-group-item' do
                = f.check_box :group, class: 'form-check-input me-2'
                Take all
        .d-grid
          = f.button type: :submit, class: 'btn btn-outline-primary' do
            %i.fa-solid.fa-hand
            Take
