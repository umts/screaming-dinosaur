{
  "private": true,
  "type": "module",
  "dependencies": {
    "@csstools/postcss-sass": "*",
    "@fortawesome/fontawesome-free": "*",
    "@fullcalendar/bootstrap5": "*",
    "@hotwired/stimulus": "*",
    "@popperjs/core": "*",
    "@rails/ujs": "*",
    "autoprefixer": "*",
    "bootstrap": "*",
    "fullcalendar": "*",
    "postcss": "*",
    "postcss-cli": "*",
    "postcss-scss": "*",
    "rolldown": "*",
    "temporal-polyfill": "*",
    "tom-select": "*"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "eslint": "*",
    "eslint-config-google": "*",
    "eslint-formatter-compact": "*",
    "globals": "*",
    "run-pty": "*",
    "stylelint": "*",
    "stylelint-config-standard": "*",
    "stylelint-config-standard-scss": "*"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
