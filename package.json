{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown --config",
    "build:css": "sass app/assets/stylesheets/application.scss:app/assets/builds/application.css --pkg-importer=node --load-path=node_modules --quiet-deps --silence-deprecation=import",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:css": "stylelint **/*.css **/*.scss"
  },
  "dependencies": {
    "@csstools/postcss-sass": "*",
    "@fortawesome/fontawesome-free": "*",
    "@fullcalendar/bootstrap5": "*",
    "@hotwired/stimulus": "*",
    "@popperjs/core": "*",
    "@rails/ujs": "*",
    "@umts/brand": "github:umts/brand#main",
    "@umts/stimulus": "github:umts/stimulus#main",
    "autoprefixer": "*",
    "bootstrap": "*",
    "fullcalendar": "*",
    "rolldown": "*",
    "sass": "*",
    "temporal-polyfill": "*",
    "tom-select": "*"
  },
  "devDependencies": {
    "oxfmt": "*",
    "oxlint": "*",
    "run-pty": "*",
    "stylelint": "*",
    "stylelint-config-standard": "*",
    "stylelint-config-standard-scss": "*"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
